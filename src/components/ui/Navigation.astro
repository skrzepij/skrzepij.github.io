---
import { NAV_ITEMS } from '@/config/routes';

const navItems = NAV_ITEMS.map((item) => ({
  ...item,
  href: item.route === 'hero' ? '/' : `/${item.route}`,
}));
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 py-4 transition-all duration-300 bg-dark-bg shadow-lg"
  style="height: 64px;"
>
  <div class="container mx-auto px-6 flex justify-between items-center h-full">
    <a href="/" class="text-2xl font-bold logo-text">
      R<span class="text-accent-yellow">S</span>
    </a>
    <div class="hidden md:flex space-x-7 items-center">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link text-primary-text font-medium hover:text-accent-yellow transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="md:hidden">
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Otwórz menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="text-gray-300 focus:outline-none"
      >
        <svg
          class="w-7 h-7 text-accent-yellow"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-dark-card shadow-lg mt-2 rounded-md mx-6"
    role="menu"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block py-3 px-6 nav-link text-primary-text hover:text-accent-yellow hover:bg-dark-lines transition-colors"
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>

<script>
  // Initialize mobile menu functionality
  function initMobileMenu() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!mobileMenuButton || !mobileMenu) return;

    // Check if already initialized (to avoid duplicate listeners)
    if (mobileMenuButton.dataset.initialized === 'true') {
      return;
    }

    // Mark as initialized
    mobileMenuButton.dataset.initialized = 'true';

    // Add click event listener to button
    mobileMenuButton.addEventListener('click', () => {
      const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      mobileMenu.classList.toggle('hidden');
      mobileMenuButton.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenuButton.setAttribute('aria-label', isExpanded ? 'Otwórz menu' : 'Zamknij menu');
    });

    // Close menu when clicking on a link
    const menuLinks = mobileMenu.querySelectorAll('a');
    menuLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'false');
        mobileMenuButton.setAttribute('aria-label', 'Otwórz menu');
      });
    });
  }

  // Update active nav link based on current URL
  function updateActiveNavLink() {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('.nav-link');

    navLinks.forEach((link) => {
      const href = link.getAttribute('href');
      link.classList.remove('active', 'text-accent-yellow');

      if ((currentPath === '/' && href === '/') || (currentPath !== '/' && href === currentPath)) {
        link.classList.add('active', 'text-accent-yellow');
      }
    });
  }

  // Initialize on load
  initMobileMenu();
  updateActiveNavLink();

  // Re-initialize on navigation (ClientRouter updates DOM)
  document.addEventListener('astro:page-load', () => {
    // Reset initialization flag for new DOM elements
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    if (mobileMenuButton) {
      mobileMenuButton.dataset.initialized = 'false';
    }
    initMobileMenu();
    updateActiveNavLink();
  });
</script>

<style>
  .nav-link.active {
    @apply text-accent-yellow;
  }
</style>
