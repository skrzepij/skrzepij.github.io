---

---

<section id="contact" class="page-section">
  <div class="slide-inner-content">
    <div class="w-full">
      <div class="container mx-auto">
        <div class="text-center mb-10 md:mb-14 fade-in-up-section">
          <h2 class="section-title">
            Skontaktuj się <span class="text-accent-yellow">ze Mną</span>
          </h2>
          <p class="section-subtitle">
            Masz ciekawy projekt lub szukasz wsparcia? Chętnie poznam Twoje potrzeby. Wypełnij
            formularz lub napisz bezpośrednio.
          </p>
        </div>
        <div
          class="max-w-2xl mx-auto bg-dark-card p-4 sm:p-8 md:p-10 rounded-lg shadow-2xl border border-dark-lines fade-in-up-section delay-1"
        >
          <form id="contact-form">
            <div class="grid sm:grid-cols-2 gap-6 mb-6">
              <div>
                <label for="name" class="block text-sm font-medium text-secondary-text mb-1">
                  Imię i Nazwisko
                </label>
                <input
                  type="text"
                  name="name"
                  id="name"
                  required
                  class="w-full px-4 py-3 bg-dark-bg border border-dark-lines rounded-md focus:ring-1 focus:ring-accent-yellow focus:border-accent-yellow outline-none transition-all duration-300 text-primary-text"
                  placeholder="Twoje Imię i Nazwisko"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-secondary-text mb-1">
                  Adres Email
                </label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  class="w-full px-4 py-3 bg-dark-bg border border-dark-lines rounded-md focus:ring-1 focus:ring-accent-yellow focus:border-accent-yellow outline-none transition-all duration-300 text-primary-text"
                  placeholder="twoj@email.com"
                />
              </div>
            </div>
            <div class="mb-6">
              <label for="subject" class="block text-sm font-medium text-secondary-text mb-1">
                Temat
              </label>
              <input
                type="text"
                name="subject"
                id="subject"
                class="w-full px-4 py-3 bg-dark-bg border border-dark-lines rounded-md focus:ring-1 focus:ring-accent-yellow focus:border-accent-yellow outline-none transition-all duration-300 text-primary-text"
                placeholder="Czego dotyczy Twoja wiadomość?"
              />
            </div>
            <div class="mb-8">
              <label for="message" class="block text-sm font-medium text-secondary-text mb-1">
                Wiadomość
              </label>
              <textarea
                name="message"
                id="message"
                rows="5"
                required
                class="w-full px-4 py-3 bg-dark-bg border border-dark-lines rounded-md focus:ring-1 focus:ring-accent-yellow focus:border-accent-yellow outline-none transition-all duration-300 text-primary-text"
                placeholder="Opisz swój projekt lub pytanie..."></textarea>
            </div>
            <div>
              <button type="submit" class="w-full btn btn-primary-yellow text-base py-3">
                Wyślij Wiadomość
              </button>
            </div>
          </form>
          <div id="form-response" class="mt-6 text-center"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const formResponse = document.getElementById('form-response') as HTMLElement | null;

  if (contactForm && formResponse) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      // TODO: Integrate with API route when ready
      formResponse.textContent = 'Dziękuję! Twoja wiadomość została "wysłana". (To jest demo)';
      formResponse.className = 'mt-6 text-center text-accent-yellow font-medium';

      contactForm.reset();

      setTimeout(() => {
        formResponse.textContent = '';
        formResponse.className = 'mt-6 text-center';
      }, 5000);
    });
  }
</script>
